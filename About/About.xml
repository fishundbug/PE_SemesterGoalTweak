<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ModMetaData>
    <name>PE: Semester Goal Tweak</name>
    <author>fishundbug</author>
    <packageId>fishundbug.PE_SemesterGoalTweak</packageId>
    <description>允许在模组设置中自定义 Progression Education 的学期目标最大经验值（原始值硬编码为 100,000）。</description>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <modDependencies>
        <li>
            <packageId>brrainz.harmony</packageId>
            <displayName>Harmony</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
            <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
        </li>
        <li>
            <packageId>ferny.ProgressionEducation</packageId>
            <displayName>Progression: Education</displayName>
        </li>
    </modDependencies>
    <loadAfter>
        <li>Ludeon.RimWorld</li>
        <li>brrainz.harmony</li>
        <li>ferny.ProgressionEducation</li>
    </loadAfter>
</ModMetaData>
